# Server
PORT=5000
NODE_ENV=development

# MySQL database connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=restaurant_db

# JWT
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# The frontend origin allowed to call this API (for CORS)
CLIENT_URL=http://localhost:5173
